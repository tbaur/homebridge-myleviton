{
  "name": "homebridge-myleviton",
  "displayName": "Homebridge My Leviton",
  "version": "4.1.4",
  "description": "A homebridge plugin for My Leviton Decora Smart devices",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "homebridge-plugin",
    "leviton",
    "decora",
    "smart",
    "homekit"
  ],
  "author": {
    "name": "tbaur",
    "url": "https://github.com/tbaur"
  },
  "maintainers": [
    {
      "name": "tbaur",
      "url": "https://github.com/tbaur"
    }
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tbaur"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tbaur/homebridge-myleviton.git"
  },
  "bugs": {
    "url": "https://github.com/tbaur/homebridge-myleviton/issues"
  },
  "homepage": "https://github.com/tbaur/homebridge-myleviton#readme",
  "dependencies": {
    "ws": "^8.22.1"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "brace-expansion@2": "^2.1.7",
    "brace-expansion@5": "^5.0.12",
    "deepmerge": "4.1.2",
    "glob": "^14.0.3",
    "handlebars": "^4.7.10",
    "minimatch": "^11.0.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "homebridge": "^2.5.0",
    "jest": "^30.5.2",
    "ts-jest": "29.4.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "homebridge": "^2.0.0",
    "node": "^22 || ^24 || ^26"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "NODE_ENV=test jest --coverage",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:unit": "NODE_ENV=test jest --coverage --testPathPatterns=tests/unit",
    "test:integration": "NODE_ENV=test jest --testPathPatterns=tests/integration --collectCoverage=false",
    "lint": "eslint . --ignore-pattern node_modules --ignore-pattern dist --ignore-pattern coverage",
    "lint:fix": "eslint . --fix --ignore-pattern node_modules --ignore-pattern dist --ignore-pattern coverage"
  },
  "files": [
    "dist/**/*",
    "config.schema.json",
    "LICENSE",
    "README.md"
  ]
}
